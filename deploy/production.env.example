COMPOSE_PROJECT_NAME=four-layer-workbench-production
API_IMAGE=four-layer-workbench-api:1.0.1
WEB_IMAGE=four-layer-workbench-web:1.0.1
POSTGRES_USER=workbench
POSTGRES_IMAGE=postgres:18-alpine@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2
POSTGRES_DB=workbench
POSTGRES_PASSWORD=replace-with-random-hex-password
DATABASE_URL=postgresql://workbench:replace-with-random-hex-password@db:5432/workbench
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=https://workbench.example.com
COOKIE_SECURE=true
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# 1 for direct Nginx; 2 only with the documented, trusted HTTPS reverse proxy.
TRUST_PROXY_HOPS=2
DB_POOL_MAX=10
SESSION_TTL_DAYS=7
ROLLOVER_SCHEDULE_ENABLED=true
