# Copy to .env and replace the development password / secret before shared deployment.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters

POSTGRES_USER=workbench
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=workbench
DATABASE_URL=postgresql://workbench:local-development-only@127.0.0.1:15432/workbench
DB_POOL_MAX=10

# For npm local dev use http://127.0.0.1:5173 as APP_ORIGIN.

# Docker Compose uses container addresses and this separate browser origin.
# Change WEB_BIND_ADDRESS to your intended bind address for remote access.
COMPOSE_APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
